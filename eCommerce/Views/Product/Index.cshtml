@model PaginatedList<Product>
@{
	ViewData["Title"] = "Product Listings";
}

<h2>Product Listing</h2>

<a asp-action="Create" asp-controller="Product" class="btn btn-secondary mb-3">Create Product</a>

@if (TempData["Message"] != null)
{
	<div class="alert alert-success alert-dismissible fade show" role="alert">
		@TempData["Message"]
		<button type="button" class="btn-close" data-bs-dimiss="alert" aria-label="Close"></button>
	</div>
}

<!-- Search and Filter Form -->
<div class="card mb-4">
	<div class="card-body">
		<form asp-action="Index" asp-controller="Product" method="get" class="row g-3">
			<div class="col-md-4">
				<label for="searchTerm" class="form-label">Search by Title</label>
				<input type="text" class="form-control" id="searchTerm" name="searchTerm" 
					   placeholder="Enter product title..." value="@ViewData["SearchTerm"]" />
			</div>

			<div class="col-md-3">
				<label for="minPrice" class="form-label">Min Price</label>
				<input type="number" step="0.01" class="form-control" id="minPrice" name="minPrice" 
					   placeholder="0.00" value="@ViewData["MinPrice"]" />
			</div>

			<div class="col-md-3">
				<label for="maxPrice" class="form-label">Max Price</label>
				<input type="number" step="0.01" class="form-control" id="maxPrice" name="maxPrice" 
					   placeholder="9999.99" value="@ViewData["MaxPrice"]" />
			</div>

			<div class="col-md-2 d-flex align-items-end">
				<button type="submit" class="btn btn-primary w-100">Search</button>
			</div>

			<div class="col-12">
				<a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary btn-sm">Clear Filters</a>
			</div>
		</form>
	</div>
</div>

@if (Model.Count() == 0)
{
	<p class="alert alert-info">No products found matching your criteria.</p>
}
else
{
	<table class="table table-striped">
		<thead>
			<tr>
				<th>@Html.DisplayNameFor(m => m.First().Title)</th>
				<th>@Html.DisplayNameFor(m => m.First().Price)</th>
				<th>Links</th>
			</tr>
		</thead>
		<tbody>
			@foreach (Product product in Model)
			{
				<tr>
					<td>@Html.DisplayFor(p => product.Title)</td>
					<td>@Html.DisplayFor(p => product.Price)</td>
					<td>
						<a class="btn btn-primary btn-sm" asp-controller="Product" asp-action="Edit" asp-route-id="@product.ProductId">Update</a>
						<a class="btn btn-danger btn-sm" asp-controller="Product" asp-action="Delete" asp-route-id="@product.ProductId">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>

	<!-- Pagination Controls -->
	<nav aria-label="Page navigation" class="mt-4">
		<ul class="pagination justify-content-center">
			<!-- Previous Page Link -->
			<li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
				<a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" 
				   asp-route-searchTerm="@ViewData["SearchTerm"]" asp-route-minPrice="@ViewData["MinPrice"]" 
				   asp-route-maxPrice="@ViewData["MaxPrice"]">Previous</a>
			</li>

			<!-- Page Info -->
			<li class="page-item disabled">
				<span class="page-link">
					Page @Model.PageIndex of @Model.TotalPages
				</span>
			</li>

			<!-- Next Page Link -->
			<li class="page-item @(Model.HasNextPage ? "" : "disabled")">
				<a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" 
				   asp-route-searchTerm="@ViewData["SearchTerm"]" asp-route-minPrice="@ViewData["MinPrice"]" 
				   asp-route-maxPrice="@ViewData["MaxPrice"]">Next</a>
			</li>
		</ul>
	</nav>
}