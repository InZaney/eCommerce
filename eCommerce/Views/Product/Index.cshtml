@model PaginatedList<Product>
@{
	ViewData["Title"] = "Product Listings";
}

<h2>Product Listing</h2>

<a asp-action="Create" asp-controller="Product" class="btn btn-secondary">Create Product</a>

@if (TempData["Message"] != null)
{
	<div class="alert alert-success alert-dismissible fade show" role="alert">
		@TempData["Message"]
		<button type="button" class="btn-close" data-bs-dimiss="alert" aria-label="Close"></button>
	</div>
}

@if (Model.Count() == 0)
{
	<p>No products are currently found</p>
}
else
{
	<table class="table table-striped">
		<thead>
			<tr>
				<th>@Html.DisplayNameFor(m => m.First().Title)</th>
				<th>@Html.DisplayNameFor(m => m.First().Price)</th>
				<th>Links</th>
			</tr>
		</thead>
		<tbody>
			@foreach (Product product in Model)
			{
				<tr>
					<td>@Html.DisplayFor(p => product.Title)</td>
					<td>@Html.DisplayFor(p => product.Price)</td>
					<td>
						<a class="btn btn-primary" asp-controller="Product" asp-action="Edit" asp-route-id="@product.ProductId">Update</a>
						<a class="btn btn-danger" asp-controller="Product" asp-action="Delete" asp-route-id="@product.ProductId">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>

	<!-- Pagination Controls -->
	<nav aria-label="Page navigation" class="mt-4">
		<ul class="pagination justify-content-center">
			<!-- Previous Page Link -->
			<li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
				<a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)">Previous</a>
			</li>

			<!-- Page Info -->
			<li class="page-item disabled">
				<span class="page-link">
					Page @Model.PageIndex of @Model.TotalPages
				</span>
			</li>

			<!-- Next Page Link -->
			<li class="page-item @(Model.HasNextPage ? "" : "disabled")">
				<a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)">Next</a>
			</li>
		</ul>
	</nav>
}